{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kakon77777-commits/AMVO/blob/main/schemas/case.schema.json",
  "title": "AMVO public mathematical source v0.1 contract (v0.1.4 implementation)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "source",
    "rights",
    "claim",
    "review",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^amvo-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "enum": [
        "public_source_intake",
        "claim",
        "synthetic_fixture"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "title",
        "authors",
        "url",
        "version",
        "captured_at",
        "public"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^?\\#]+$",
          "maxLength": 1200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "captured_at": {
          "type": "string",
          "format": "date",
          "maxLength": 1200
        },
        "public": {
          "const": true
        },
        "pin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "git_commit"
                },
                "value": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "arxiv_version"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{4}\\.[0-9]{4,5}v[1-9][0-9]*$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "sha256"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": [
        "mode",
        "note"
      ],
      "properties": {
        "mode": {
          "enum": [
            "metadata_only",
            "redistribution_cleared"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "statement",
        "scope"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "under_review",
            "needs_revision",
            "withdrawn"
          ]
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "lhs",
              "rhs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "const": "rational_sum"
              },
              "lhs": {
                "$ref": "#/$defs/fractions"
              },
              "rhs": {
                "$ref": "#/$defs/fractions"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "lhs_coefficients",
              "rhs_coefficients"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "const": "polynomial_coefficients"
              },
              "lhs_coefficients": {
                "$ref": "#/$defs/fractions"
              },
              "rhs_coefficients": {
                "$ref": "#/$defs/fractions"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "path",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "const": "file_sha256"
              },
              "path": {
                "type": "string",
                "pattern": "^evidence(/(?!\\.\\.?(/|$))[^/\\\\\\u0000]+)+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "$defs": {
    "fractions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]{1,80}(/[0-9]{1,80})?$"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "claim"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "pin"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "public_source_intake"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
